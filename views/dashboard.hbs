<style>
  /* COLUNM METHOD */
  .grid-container {
    display: grid;
    grid-template-columns: 1fr;
    height: 100vh;
    grid-template-rows: auto 1fr auto;
  }

  .grid-container>div {
    width: 100%;
  }

  .header {
    background-color: #f8f9fa;
    padding: 5px;
    display: flex;
    justify-content: space-between;
  }

  .content {
    background-color: #e9ecef;
    padding: 10px;
    width: 100%;
  }

  li {
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  #welcome {
    margin: 1rem 3rem;
  }


  .p-count {
    width: 300px;
    height: 130px;
    background: white;
    margin: 0 auto;
  }

  .p-count>h3 {
    text-align: center;
    padding: 1rem;
  }

  .p-count>span {
    margin: 5rem;
  }

  .d-post {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
  }

  @media screen and (max-width: 600px) {

    .d-post {
      gap: 5px;
      display: block;
    }
  }

  @media screen and (max-width: 900px) {

    .d-post {
      gap: 5px;
      display: block;
    }
  }
</style>

<div class="grid-container">

  <div class="header">
    <img src="" alt="Logo">
    <div>Notification</div>
    <a href="/profile" id="dProfile"> <img style="width: 50px; height: 50px; border-radius: 3rem;" src="{{user.image}}"
        alt="{{user.name}}"> </a>
  </div>

  {{> writersNavs}}
  <marquee style="color: brown">
    Your steady posting can attract works for you and keep you open
    to learn and teach new things
  </marquee>

  <div id="mainContent" class="content">
    <div class="content">
      {{!-- <button id="navMenu">MENU</button> --}}

      <div id="welcome">
        <i>WELCOME</i> <b>{{user.name}}</b>
        <p>
          <h4>Resident Address</h4>
          <p>{{writer.address.residentAddress.street}}, {{writer.address.residentAddress.city}}, {{writer.address.residentAddress.state}}, {{writer.address.residentAddress.country}}</p>
        </p>
        <p>
          <h4>Occupation</h4>
          <span>{{user.occupation}}</span>
        </p>
      </div>

      <div class="d-post">

        <div class="p-count">
          <h3>Published Posts</h3>
          <span>NIL</span>
        </div>

        <div class="p-count">
          <h3>Unpublished Posts</h3>
          <span>NIL</span>
        </div>

      </div>

      <div>
        <div>Newly Published Post</div>
      </div>

    </div>
     <!-- Profile Image -->
  <div id="picForm">
    <h3>Change Profile Picture</h3>
    <form action="/address" method="POST">
      <input type="hidden" name="id" value="{{user.id}}" required>
      <input type="text" name="name">
      <input type="text" name="address">
      <input type="text" name="occupation">
      <button id="" type="submit">Upload</button>
    </form>
    <button class="cls" id="picClose"><b>Close</b></button>
  </div>
  </div>

<hr><hr><hr>
{{#if writer.address}}
  <h2>Addresses</h2>
  <p><strong>Resident Address:</strong> {{writer.address.residentAddress.street}}, {{writer.address.residentAddress.city}}, {{writer.address.residentAddress.state}}, {{writer.address.residentAddress.country}}</p>
  <p><strong>Home Address:</strong> {{writer.address.homeAddress.street}}, {{writer.address.homeAddress.city}}, {{writer.address.homeAddress.state}}, {{writer.address.homeAddress.country}}</p>
{{else}}
  <p>No address on file.</p>
{{/if}}

  <div style="background: papayawhip">
  <form action="/addresses" method="POST" class="address-form">
        <!-- Hidden Writer ID -->
        <input type="hidden" name="writerId" value="{{user.id}}">

    <!-- Resident Address Section -->
    <fieldset>
      <legend>Resident Address</legend>
      
      <div class="form-group">
        <label for="resident-country">Country</label>
        <input type="text" id="resident-country" name="residentAddress[country]">
      </div>

      <div class="form-group">
        <label for="resident-state">State</label>
        <input type="text" id="resident-state" name="residentAddress[state]">
      </div>

      <div class="form-group">
        <label for="resident-city">City</label>
        <input type="text" id="resident-city" name="residentAddress[city]" value="{{writer.address.residentAddress.street}}">
      </div>

      <div class="form-group">
        <label for="resident-street">Street</label>
        <input type="text" id="resident-street" name="residentAddress[street]">
      </div>
    </fieldset>

    <!-- Home Address Section -->
    <fieldset>
      <legend>Home Address</legend>

      <div class="form-group">
        <label for="home-country">Country</label>
        <input type="text" id="home-country" name="homeAddress[country]">
      </div>

      <div class="form-group">
        <label for="home-state">State</label>
        <input type="text" id="home-state" name="homeAddress[state]">
      </div>

      <div class="form-group">
        <label for="home-city">City</label>
        <input type="text" id="home-city" name="homeAddress[city]">
      </div>

      <div class="form-group">
        <label for="home-street">Street</label>
        <input type="text" id="home-street" name="homeAddress[street]">
      </div>
    </fieldset>

    <button type="submit">Save Addresses</button>
  </form>

  </div>



  {{> footer}}
</div>

